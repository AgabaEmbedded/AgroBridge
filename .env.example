DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Embeddings: Gemini gemini-embedding-001 (1536-dimensional, L2-normalised).
# The key can also be supplied as GOOGLE_API_KEY.
GEMINI_API_KEY=replace-with-your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1536
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_TIMEOUT=30
GEMINI_EMBEDDING_RETRIES=3

# Keep this short because the voice webhook may have a strict response timeout.
LLM_TIMEOUT_SECONDS=4.0
MAX_OUTPUT_TOKENS=140
TOP_K=4
MIN_RELEVANCE_DISTANCE=1.25

# In-process conversation memory: 8 messages (4 exchanges) kept for 30 minutes.
HISTORY_MAX_MESSAGES=8
HISTORY_TTL_SECONDS=1800

# Optional: required for /debug/ask from non-localhost clients (sent as X-Debug-Token).
DEBUG_API_TOKEN=


# Multi-agent workflows
AGENT_TIMEOUT_SECONDS=45
VERIFIER_ENABLED=true
MAX_REVISIONS=2
# Hard Voicebip ceiling is 5 s; the QA graph stops verifying/reasoning before it.
QA_BUDGET_SECONDS=4.3
QA_DEBUG_BUDGET_SECONDS=60
GAP_TOP_K=6
GAP_MAX_ROUNDS=2
GAP_TIMEOUT_SECONDS=240
GAP_MAX_OUTPUT_TOKENS=1200
AUDIT_ENABLED=true
# Optional: require X-Gap-Token on POST /api/gap-analysis.
GAP_API_TOKEN=
# Comma-separated browser origins allowed to call the API (frontend dev server).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Keep this short because the voice webhook may have a strict response timeout.
LLM_TIMEOUT_SECONDS=4.0
MAX_OUTPUT_TOKENS=140
TOP_K=6
# Chroma cosine distance; lower is closer. Calibrated on labelled crop questions.
MIN_RELEVANCE_DISTANCE=0.15

# In-process conversation memory: 8 messages (4 exchanges) kept for 30 minutes.
HISTORY_MAX_MESSAGES=8
HISTORY_TTL_SECONDS=1800

# Optional: required for /debug/ask from non-localhost clients (sent as X-Debug-Token).
DEBUG_API_TOKEN=


# Multi-agent workflows
AGENT_TIMEOUT_SECONDS=45
VERIFIER_ENABLED=true
MAX_REVISIONS=2
# Hard telephony ceiling is ~5 s; the QA graph stops verifying/reasoning before it.
QA_BUDGET_SECONDS=4.3
QA_DEBUG_BUDGET_SECONDS=60
GAP_TOP_K=6
GAP_MAX_ROUNDS=4
GAP_TIMEOUT_SECONDS=240
GAP_MAX_OUTPUT_TOKENS=1200
AUDIT_ENABLED=true
# Optional: require X-Policy-Token on POST /api/policy-analyzer.
GAP_API_TOKEN=
# Comma-separated browser origins allowed to call the API (frontend dev server).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Noisy ASR transcripts: optional LLM normaliser before routing + prompt hint.
TRANSCRIPT_CORRECTION_ENABLED=true
TRANSCRIPT_CORRECTION_TIMEOUT=3.0
NOISY_TRANSCRIPT_HINT=true

# Vapi telephony (custom LLM + server events)
VAPI_PUBLIC_BASE_URL=https://your-public-host.example
# Optional authentication; configure matching values in Vapi.
VAPI_WEBHOOK_SECRET=
VAPI_CUSTOM_LLM_SECRET=

ELEVENLABS_VOICE_ID=i9sr2Eu9ynYVEaDDkF8I

# AI conversation router (replaces the rule-based fallback)
CONVERSATION_AI_ENABLED=true
CONVERSATION_AI_TIMEOUT=2.0
# Vapi custom-LLM requests can wait longer than the 5 s telephony webhook.
VAPI_QA_BUDGET_SECONDS=8.0

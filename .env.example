DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Keep this short because the voice webhook may have a strict response timeout.
LLM_TIMEOUT_SECONDS=4.0
MAX_OUTPUT_TOKENS=140
TOP_K=4
MIN_RELEVANCE_DISTANCE=1.25

# outbound_call.py (Twilio). Rotate any token that has ever been committed or shared.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
